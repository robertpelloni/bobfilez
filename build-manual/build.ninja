build fo_c_api: phony core/libfo_c_api.a

build fo_cli: phony cli/fo_cli.exe

build fo_cli.exe: phony cli/fo_cli.exe

build fo_core: phony core/libfo_core.a

build libfo_c_api.a: phony core/libfo_c_api.a

build libfo_core.a: phony core/libfo_core.a

