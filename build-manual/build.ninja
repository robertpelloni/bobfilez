build cli/CMakeFiles/install/strip.util: CUSTOM_COMMAND cli/all
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\Users\hyper\workspace\bobfilez\build-manual\cli && C:\tools\cmake\bin\cmake.exe -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake"
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build cli/install/strip: phony cli/CMakeFiles/install/strip.util

